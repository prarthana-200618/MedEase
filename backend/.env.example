PROJECT_NAME="MedEase"
ENVIRONMENT="development"
SECRET_KEY="medease-insecure-development-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration:
# Default to SQLite for immediate zero-config development.
# Switch to MySQL once MySQL Server 8.0 is running:
# DATABASE_URL="mysql+pymysql://medease_user:medease_password@localhost:3306/medease"
DATABASE_URL="sqlite:///./medease.db"

# Storage
STORAGE_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=15

# AI Service Configuration
# Options: mock, gemini, openai
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Malayalam Text To Speech Provider
# Options: mock, browser, gtts
TTS_PROVIDER="mock"

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
